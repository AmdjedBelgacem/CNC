# Database
# Placeholder credentials only. Never put a real password here: this file is
# tracked in git on purpose (it documents the deployment contract), and the
# pre-commit secret scanner blocklists the real local password it used to hold.
DATABASE_URL=postgresql://app:<password>@localhost:5432/app

# Pool sizing. Supabase enforces a per-client connection cap, so keep DATABASE_POOL_MAX
# under your project's limit. The transaction-mode pooler is port 6543; the direct
# connection is IPv6-only unless the IPv4 add-on is enabled.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
# Supabase example (transaction pooler — prepared statements are disabled in code):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# Auth Secrets
AUTH_SECRET=change-this-to-a-random-secret-in-production
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_REMEMBER=30d

# Argon2id Parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP / Email (Resend preferred; SMTP fallback)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@titansofmanufacturing.com

# Supabase Auth (Phase 2). Tenancy and RBAC stay in this application; Supabase only
# answers "who is this?".
#
# The values below are NOT used by this backend — they are set in the Supabase
# dashboard (Authentication → Providers → Email / SMTP) so that Supabase's own
# confirmation and password-reset emails go out through Resend. Resend SMTP:
#   host smtp.resend.com, port 465 (TLS) or 587 (STARTTLS),
#   username "resend", password = your Resend API key.
#
# Then copy the project's URL, anon key, service-role key and JWT secret here:
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mux Video
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# S3 / MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=titans-cnc
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

AI_ASSISTANT_ENCRYPTION_KEY=
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com
AI_PROVIDER_MAX_RESPONSE_BYTES=1048576
AI_PROVIDER_TIMEOUT_MS=15000
FX_RATES_URL=

# URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=4000

# Analytics (optional env fallback — tenant Admin → Settings → Analytics wins when set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment targets
#
# One codebase, three targets, one switch. Whichever host runs the backend, the
# frontend only ever needs API_URL changed — no code edit, no other rebuild.
# Resolution order lives in apps/frontend/src/lib/server-api-url.ts:
#
#   API_URL  ->  API_INTERNAL_URL  ->  NEXT_PUBLIC_API_URL  ->  localhost:4000
#
#   Vercel (frontend only) : API_URL = https://<your-app>.fly.dev
#   Hetzner later          : API_URL = https://api.example.com   (one value change)
#   Single-project Vercel  : leave API_URL unset, the service binding is used
#   Local docker compose   : API_URL unset, NEXT_PUBLIC_API_URL covers it
# ─────────────────────────────────────────────────────────────────────────────

# Server-only. Never exposed to the browser; the /api/proxy BFF and the
# /uploads/* rewrite both resolve through it.
API_URL=

# Comma-separated origins allowed to make credentialed requests. Falls back to
# FRONTEND_URL. Vercel preview origins are matched by *.vercel.app suffix, so they
# do not need listing individually.
#   CORS_ORIGINS=https://cnc-rho-lilac.vercel.app,http://localhost:3000
CORS_ORIGINS=

# Socket.IO namespace URL. Leave EMPTY to stay same-origin through the Vercel
# rewrite to /socket.io/* — the default and the recommended setting.
#
# Setting it to a cross-origin Fly URL does NOT authenticate: the auth cookie is
# named __Host-access, so it is host-only to the Vercel domain and the browser
# will not send it to *.fly.dev. See docs/ops/DEPLOY_VERCEL_FLY.md, "WebSockets".
# NEXT_PUBLIC_WS_URL=

# Vercel/Fly only: keep the two in sync or every email link and OAuth callback
# points at a dead domain. Fly reads FRONTEND_URL; Supabase Auth needs the Vercel
# production URL added under Authentication -> URL Configuration.
#   FRONTEND_URL=https://cnc-rho-lilac.vercel.app

# Fly only. Bind address for the long-running server.
HOST=0.0.0.0
