{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/frontend",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo build --filter=@titan/frontend",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": "apps/backend",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/auth/oauth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
