# Deployment target .env for the Lightsail single-origin stack.
#
# Copy this file to deploy/lightsail/.env, chmod 600 it, and fill every REQUIRED
# value. Anything marked OPTIONAL can be removed or left empty. Values are real
# credentials in production — never commit this file (it is gitignored).

# ── Domain / Caddy ─────────────────────────────────────────────────────────────
# Public domain for this deployment. Must have its A record pointing at this host.
DOMAIN=barootcnc.com
# TLS registration address for Let's Encrypt / ZeroSSL.
ACME_EMAIL=ops@barootcnc.com
# Where the containers come up relative to Caddy. Defaults shown.
API_UPSTREAM=backend:4000
FRONTEND_UPSTREAM=frontend:3000

# ── Frontend (baked into the image at build time) ───────────────────────────────
# These are inlined into the client bundle by `next build`.
NEXT_PUBLIC_SITE_URL=https://barootcnc.com
# Left blank by default; middleware falls back to localhost:4000. Only needed if you
# want browser code to reach the API without the BFF. For a single-origin stack
# Leave this blank.
NEXT_PUBLIC_API_URL=
# Leave blank: /socket.io is same-origin through Caddy. Direct websocket is only
# needed if you change CORS/cookie policy.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=cnc-fundamentals
NEXT_PUBLIC_REALTIME_MODE=auto
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=

# ── Backend (server secrets — pair these with the frontend BFF API_URL inside
#    the container) ────────────────────────────────────────────────────────────
# The frontend container sets API_URL=http://backend:4000, so the BFF resolves this
# hostname on the Docker network. You do NOT set API_URL here.
NODE_ENV=production
LOG_LEVEL=info
FRONTEND_URL=https://barootcnc.com
# Comma-separated origins. Usually redundant with FRONTEND_URL; include preview/alias
# hostnames here if you ever serve the stack on more than one host.
CORS_ORIGINS=

# Supabase stays external — use the same project your auth tokens are signed by.
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_ENABLED=true

# App-level signing secrets. Must be real high-entropy strings; rotate them together
# if compromised, and never downgrade to a placeholder.
AUTH_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_REMEMBER=30d

# DB password/session: PostgreSQL session pooler on Supabase (port 5432, 15-client
# limit across the whole project). The app's DATABASE_POOL_MAX should stay under 10.
DATABASE_URL=postgresql://postgres.YOUR-REF:<YOUR-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=no-verify
DATABASE_POOL_MAX=10

# Local Redis inside the stack: internal network only, not published. Throttler and
# public cache fallback to DB when this is unreachable, so health degrades instead
# of crashing.
REDIS_URL=redis://redis:6379/0
REDIS_DB_INDEX=0

# Optional full-text search.meili must be on with the "search" profile for this to
# work.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Outgoing transactional email (Resend). SMTP_FROM must be on a verified domain,
# otherwise sends fail with an error — the health check will show it as degraded.
RESEND_API_KEY=
SMTP_FROM=notifications@YOUR-DOMAIN

# Storage via Supabase S3-compatible endpoint (usually the *.storage.supabase.co path).
S3_ENDPOINT=https://YOUR-REF.storage.supabase.co
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
S3_BUCKET=uploads
S3_MEDIA_BUCKET=media
# Public URL back to the bucket, must match the bucket used in uploads.
S3_PUBLIC_URL=https://YOUR-REF.supabase.co/storage/v1/object/public/uploads
S3_FORCE_PATH_STYLE=true

# AI provider guardrails. The app only talks to api.openai.com and only embeds
# documents you upload; this key is used to encrypt provider keys at rest.
AI_ASSISTANT_ENCRYPTION_KEY=
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com
AI_PROVIDER_MAX_RESPONSE_BYTES=1048576
AI_PROVIDER_TIMEOUT_MS=15000

# Argon2 work factor matches the seed (and the Next server can verify). 65536 bytes
# is only ~64MB per hash, and it runs once.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Moyasar payment provider. Empty placeholder means payments are disabled; any
# attempt to pay fails closed. Fill these before launch.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=

# ── Optional knobs ─────────────────────────────────────────────────────────────
# Caddyfile path. Usually ./Caddyfile; override only for multi-domain setups.
CADDYFILE_PATH=./Caddyfile