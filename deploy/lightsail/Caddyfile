# Caddy for the Lightsail single-origin deployment.
#
# One domain, three routes. Everything that belongs to the backend is addressed
# before the catch-all, and so the middleware rewrite inside Next never has to be
# trusted for those paths (it never runs because the browser never reaches Next
# with them). /socket.io carries plain HTTP polling — Vercel or not, WebSocket
# upgrade still needs a real proxy that supports it, which this is.
{
	# ACM-style certificate email, matches ACME_EMAIL env var.
	email {$ACME_EMAIL}
	# Automatic HTTPS via Let's Encrypt / ZeroSSL. This machine must be reachable
	# on :80/:443 publicly or this will fail healthily: set it in the firewall
	# section of the docs.
}

# Injected into the scope via the container environment ({$VAR}), documented in
# .env.example. Example DOMAIN=barootcnc.com
{$DOMAIN} {
	# Compression for text assets. PDFs and images are already compressed and
	# compressing them again wastes CPU.
	encode zstd gzip

	# Fastifying already emits request logs, and upstream responses already have
	# proper content-type. Avoid Caddy default logging noise for routine requests.
	# Access log goes to a file bind-mounted from the host, not stdout. Reason:
	# the fail2ban jail below correlates abusive IPs from this log, and reading it
	# out of docker's per-container json files broke every time the container was
	# recreated (a new container id, and the old log file is deleted with it) —
	# the jail went silently quiet while still reporting "0 failures". A stable path
	# also means the filter reads plain JSON instead of the docker driver's
	# escaped-quote wrapping, and Caddy rolls the file itself so it cannot fill
	# the disk.
	log {
		output file /var/log/caddy/access.log {
			roll_size     10MiB
			roll_keep     5
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	header {
		# This is the only origin for the app (FRONTEND_URL points here), and Caddy
		# terminates TLS, so these headers are safe.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		# SAMEORIGIN rather than DENY: DENY also blocks our own origin from framing
		# itself, which the admin page builder will want the moment it renders a
		# preview in an iframe. External framing stays blocked either way.
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# The platform uses no camera, microphone or geolocation; deny all three so
		# an injected script cannot prompt for them.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Caddy's own Server header is always added in front of the response, but
		# stripping it reduces fingerprinting risk.
		-Server
		# App sets its own CSP per-request with a nonce (middleware). Caddy only
		# frames the policy; no need to duplicate here.
	}

	# ---- Edge rate limits ----------------------------------------------------
	# Requires the caddy-ratelimit module (CADDY_IMAGE), and note its semantics:
	# `events` IS the allowance (max_events) and `window` the sliding window. There
	# is no `burst` and no `limit` subdirective — writing them looks plausible and is
	# silently ignored, which is how this zone once ended up allowing ONE login per
	# minute per IP.
	#
	# Each limit is deliberately LOOSER than the application throttle for the same
	# route, so the API's own 429 is what a real person sees and this only absorbs
	# floods before they reach a 2 GB box:
	#   login 10/min, register+forgot+reset 3/hr, global 100 req/min (all per IP).
	#
	# KEY CAVEAT: {http.request.remote.host} is the TCP peer, which is the real
	# client today because Caddy is the edge. If Cloudflare goes in front, every key
	# collapses onto Cloudflare's own IPs and these limits become global rather than
	# per-caller. When that happens, add `trusted_proxies static <Cloudflare ranges>`
	# and switch the key to {http.request.header.CF-Connecting-IP}. Never switch the
	# key first: trusting that header without the proxy allowlist lets any caller
	# forge an IP and walk straight out of the limit.
	#
	# ipv6_prefix 64: a single subscriber /64 holds ~2^64 addresses, so per-address
	# IPv6 limits are trivially bypassed. Bucketing the /64 makes cycling useless.
	@rl_login path /api/proxy/auth/login
	rate_limit @rl_login {
		zone auth_login {
			key         {http.request.remote.host}
			events      12
			window      1m
			ipv6_prefix 64
		}
	}

	@rl_auth_write path /api/proxy/auth/register /api/proxy/auth/forgot-password /api/proxy/auth/reset-password /api/proxy/auth/resend-verification /api/proxy/auth/verify-email
	rate_limit @rl_auth_write {
		zone auth_write {
			key         {http.request.remote.host}
			events      10
			window      1m
			ipv6_prefix 64
		}
	}

	# Both spellings are live: the browser starts at /api/proxy/auth/oauth/* (Next BFF)
	# and Google calls back on /auth/oauth/* which Caddy routes straight to the API.
	# Limiting only the direct path left the BFF path completely uncovered.
	@rl_oauth path /api/proxy/auth/oauth/* /auth/oauth/*
	rate_limit @rl_oauth {
		zone oauth {
			key         {http.request.remote.host}
			events      30
			window      1m
			ipv6_prefix 64
		}
	}

	# Several tabs can each refresh a session on load, so this one is generous.
	@rl_refresh path /api/proxy/auth/refresh
	rate_limit @rl_refresh {
		zone auth_refresh {
			key         {http.request.remote.host}
			events      60
			window      1m
			ipv6_prefix 64
		}
	}

	# ---- Socket.IO ----------------------------------------------------------
	# The namespace URL the browser calls is the Socket.IO HTTP path on the same
	# origin. Caddy proxies it straight to the backend (which holds the WS upgrade
	# and HTTP polling endpoints). websocket is the default upgrade path and Caddy
	# supports it out of the box.
	@socket path /socket.io/*
	handle @socket {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {remote_host}
			header_up Host $host
			transport http {
				# Never drop an open socket if traffic is bursty or the client is slow.
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	# ---- OAuth --------------------------------------------------------------
	# Google/GitHub call back to the API on our public origin, and the backend
	# sets cookies and 302s onward. Must reach the backend, not the Next app.
	@oauth path /auth/oauth/*
	handle @oauth {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
			header_up Host $host
		}
	}

	# ---- Uploaded media (Fastify static) ------------------------------------
	@uploads path /uploads/*
	handle @uploads {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
			header_up Host $host
		}
	}

	# ---- Everything else: the Next app --------------------------------------
	# HTML/SSR, /api/proxy/* (Next route handler proxy to the backend), customer
	# routes, metadata,images handled by the Next optimizer.
	handle {
		reverse_proxy {$FRONTEND_UPSTREAM} {
			header_up X-Forwarded-Proto https
			header_up Host $host
		}
	}

	# Fly/Hetzner-style health hint so the host itself can probe the stack
	# without depending on any app path.
	handle_path /__ping {
		respond pong 200
	}
}

# HTTP to HTTPS redirect. Caddy's automatic HTTPS does this by default, but we
# make it explicit so it stays visible if you edit the TLS block later. Configured
# for both apex and www: visitors typed www should end up on https apex after one
# hop, not two.
http://{$DOMAIN}, http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# www TLS block: required even though it only redirects, because Caddy needs to
# hold a certificate for www in order to answer the TLS handshake that precedes the
# redirect. Without it, browsers on www.* fail with a rate-own cert before the
# redirect is in play. 301 preserves the original request method.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
