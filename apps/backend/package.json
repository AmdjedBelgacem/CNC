{
  "name": "@titan/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:baseline": "node ./scripts/baseline-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs src/database/seed.ts",
    "ai:reindex": "npm run build && node dist/cli/ai-reindex.js",
    "db:repair-journal": "node scripts/repair-migration-journal.mjs",
    "db:check-order": "node scripts/check-migration-order.mjs",
    "db:replay-check": "node scripts/replay-migrations.mjs",
    "db:compare-schema": "node scripts/compare-schemas.mjs",
    "db:migrate-data": "node scripts/migrate-data.mjs",
    "db:sync-users": "node scripts/sync-users-to-supabase.mjs",
    "db:send-recovery": "node scripts/send-recovery.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "db:migrate-local-assets": "node scripts/migrate-local-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@titan/shared": "workspace:*",
    "@types/pdfkit": "0.17.6",
    "argon2": "^0.45.1",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.0",
    "fastify-raw-body": "6.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "9.0.2",
    "meilisearch": "0.60.0",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "0.20.2",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.18.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.0.0",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
