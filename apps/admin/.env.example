# Matches the local PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://titans:titans@localhost:5432/titans_cnc

# Use a unique, long random value outside local development.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Optional: enable MinIO / S3-backed media storage. Leave these unset to use
# Payload's local media directory during development.
# S3_BUCKET=titans-local
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9002
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
